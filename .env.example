# ==============================================================================
# ATLAS — Academic Thesis Lifecycle & Assessment Suite
# Environment Configuration Template
# ==============================================================================

# Application Environment (dev / staging / prod)
PYTHON_ENV=dev
APP_URL=http://localhost:8000

# Database Configuration
# For SQLite (default local development):
# Leave DB_URL commented or blank to automatically use atlas.db in the project root.
# DB_URL=sqlite:///atlas.db

# For PostgreSQL (Docker or production):
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=atlas_user
DB_PASSWORD=atlas_password
DB_NAME=atlas_db
DB_URL="postgresql://atlas_user:atlas_password@localhost:5432/atlas_db"

# JWT & Authentication Security
# Generate a strong 256-bit random key in production
SECRET_KEY=atlas_super_secret_jwt_encryption_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320
JWT_REFRESH_EXPIRY=30

# File Storage Configuration
# Academic documents, proposals, and deliverables are stored here securely
FILE_STORAGE_DIR=filestorage
MAX_UPLOAD_SIZE_MB=50

# SMTP / Email Notifications (Optional for Local Development)
MAIL_USERNAME=notifications@atlas.edu
MAIL_PASSWORD=your_secure_smtp_password
MAIL_FROM=notifications@atlas.edu
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Firebase Cloud Messaging / Integrations (Optional)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_APP_ID=""
